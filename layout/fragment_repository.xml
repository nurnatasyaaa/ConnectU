<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E7E3FF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#DDD6FE"
                android:elevation="6dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="3dp">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/logo"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Repository"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="#46117D" />

            </LinearLayout>

            <!-- Content Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:background="@drawable/bg_course_card"
                    android:elevation="6dp"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active Semester"
                        android:textSize="13sp"
                        android:textColor="#6B7280" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Information Technology"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#111827"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Explore your notes by category"
                        android:textSize="14sp"
                        android:textColor="#6B7280"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resource Categories"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:id="@+id/cardNotes"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:text="Notes\nCompiled files from students"
                    android:textSize="16sp"
                    android:textColor="#111827"
                    android:padding="18dp"
                    android:background="@drawable/bg_course_card"
                    android:elevation="6dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/cardQuizzes"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:text="Quizzes\nPractice sets and revision questions"
                    android:textSize="16sp"
                    android:textColor="#111827"
                    android:padding="18dp"
                    android:background="@drawable/bg_course_card"
                    android:elevation="6dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/cardFinalPapers"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:text="Final Papers\nPast year papers and references"
                    android:textSize="16sp"
                    android:textColor="#111827"
                    android:padding="18dp"
                    android:background="@drawable/bg_course_card"
                    android:elevation="6dp"
                    android:layout_marginBottom="90dp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Floating Upload Button -->
    <TextView
        android:id="@+id/btnUpload"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:text="+"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:background="#6366F1"
        android:elevation="10dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp" />

</FrameLayout>