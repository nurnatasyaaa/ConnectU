<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E7E3FF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/threadContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="18dp">

                <TextView
                    android:id="@+id/btnBack"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:text="←"
                    android:textSize="28sp"
                    android:textColor="#111827"
                    android:gravity="center" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Discussion Thread"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#111827" />

                <TextView
                    android:id="@+id/btnMore"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="⋮"
                    android:textSize="26sp"
                    android:gravity="center"
                    android:textColor="#111827" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alex\n4 mins ago"
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="How to use Putty?"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:id="@+id/tvContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Discussion content..."
                android:textSize="17sp"
                android:textColor="#111827"
                android:lineSpacingExtra="4dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="18dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E7EB"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="22dp">

                <TextView
                    android:id="@+id/tvReplyCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💬 0 replies"
                    android:textSize="14sp"
                    android:textColor="#111827"
                    android:layout_marginEnd="30dp" />

                <TextView
                    android:id="@+id/tvLikeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="♡ 0 likes"
                    android:textSize="14sp"
                    android:textColor="#111827" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/replyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom reply bar -->
    <LinearLayout
        android:id="@+id/bottomReplyBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/etReply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:layout_weight="1"
            android:hint="Write a reply..."
            android:background="@android:color/transparent"
            android:textColor="#111827"
            android:textColorHint="#6B7280"
            android:maxLines="4"
            android:gravity="center_vertical"
            android:inputType="textMultiLine"
            android:imeOptions="actionSend" />

        <TextView
            android:id="@+id/btnSendReply"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:text="➤"
            android:textSize="22sp"
            android:textColor="#6366F1"
            android:gravity="center" />

    </LinearLayout>

</LinearLayout>